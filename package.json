{
  "name": "@auraone/rubric-studio-open",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Local-first IDE for authoring, validating, testing, calibrating, diffing, and exporting AI evaluation rubrics.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/domain/self-test.ts",
    "test:a11y": "node scripts/a11y-smoke.mjs",
    "test:e2e": "node scripts/browser-smoke.mjs",
    "test:design": "node scripts/design-contract.mjs",
    "test:privacy": "node scripts/privacy-contract.mjs",
    "test:snapshot": "tsx src/domain/snapshot-test.ts",
    "test:perf": "tsx src/domain/performance-test.ts",
    "test:regression": "pnpm run test:snapshot && pnpm run test:perf",
    "tauri:e2e": "node scripts/tauri-native-smoke.mjs",
    "tauri:e2e:preflight": "node scripts/tauri-e2e-preflight.mjs",
    "tauri:build:ci": "tauri build --debug --no-bundle",
    "tauri:build:mac:debug": "tauri build --debug --bundles app",
    "tauri:core:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri:check": "cargo check --manifest-path src-tauri/Cargo.toml --features tauri-runtime",
    "vscode:contract": "node scripts/vscode-extension-contract.mjs",
    "vscode:typecheck": "tsc -p vscode-extension/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-updater": "2.10.1",
    "@vitejs/plugin-react": "^4.0.0",
    "lucide-react": "0.554.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.0",
    "vite": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.2",
    "@playwright/test": "1.56.0",
    "@tauri-apps/cli": "2.11.1",
    "@types/node": "^20.17.9",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0"
  }
}
