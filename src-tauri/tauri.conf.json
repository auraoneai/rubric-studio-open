{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rubric Studio Open",
  "version": "0.1.0",
  "identifier": "ai.auraone.rubricstudio.open",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rubric Studio Open",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:11434 https://api.openai.com https://api.anthropic.com https://generativelanguage.googleapis.com https://huggingface.co https://intake.auraone.ai"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "appimage", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "sidecars/iaa-kit",
      "sidecars/judge-bench",
      "sidecars/contamination-audit",
      "sidecars/prompt-rubric-drift",
      "sidecars/eval-adapter",
      "sidecars/auraone-evalkit"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["auraone"]
      }
    }
  }
}
