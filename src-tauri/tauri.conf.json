{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rubric Studio Open",
  "version": "0.1.0",
  "identifier": "ai.auraone.rubricstudio.open",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rubric Studio Open",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' http://localhost:11434 https://api.openai.com https://api.anthropic.com https://generativelanguage.googleapis.com https://huggingface.co https://updates.auraone.ai https://updates2.auraone.ai https://intake.auraone.ai https://o.auraone.ai https://sentry.io; frame-src 'none'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "appimage", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": []
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://updates.auraone.ai/rubric-studio-open/{{target}}/{{arch}}/{{current_version}}",
        "https://updates2.auraone.ai/rubric-studio-open/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "<PLATFORM_UPDATE_PUBKEY>"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["auraone"]
      }
    }
  }
}
