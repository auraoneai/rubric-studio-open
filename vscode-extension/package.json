{
  "name": "rubric-studio-open-vscode",
  "displayName": "Rubric Studio Open",
  "publisher": "auraone",
  "version": "0.1.0",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/auraoneai/rubric-studio-open.git"
  },
  "files": [
    "dist/extension.js",
    "dist/validator.js",
    "media/**",
    "LICENSE"
  ],
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:auraone.rubricStudio.open",
    "onCommand:auraone.rubricStudio.validate",
    "workspaceContains:**/rubric.toml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "auraone.rubricStudio.open",
        "title": "Rubric Studio Open: Editor"
      },
      {
        "command": "auraone.rubricStudio.validate",
        "title": "Rubric Studio Open: Validate Project"
      },
      {
        "command": "auraone.rubricStudio.commands",
        "title": "Rubric Studio Open: Command Palette"
      },
      {
        "command": "auraone.rubricStudio.exportIntake",
        "title": "Rubric Studio Open: Prepare Intake Export"
      }
    ],
    "keybindings": [
      {
        "command": "auraone.rubricStudio.open",
        "key": "ctrl+k ctrl+r",
        "mac": "cmd+k cmd+r"
      },
      {
        "command": "auraone.rubricStudio.commands",
        "key": "ctrl+k ctrl+k",
        "mac": "cmd+k cmd+k"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/node": "^26.0.1"
  }
}
