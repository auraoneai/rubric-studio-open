{
  "name": "rubric-studio",
  "displayName": "Rubric Studio Open",
  "publisher": "auraone",
  "version": "0.2.0",
  "license": "MIT",
  "private": false,
  "description": "Author, validate, and export Rubric Studio Open projects from VS Code.",
  "repository": {
    "type": "git",
    "url": "https://github.com/auraoneai/rubric-studio-open.git"
  },
  "homepage": "https://rubricstudio.auraone.ai/",
  "bugs": {
    "url": "https://github.com/auraoneai/rubric-studio-open/issues"
  },
  "files": [
    "dist",
    "media",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:auraone.rubricStudio.open",
    "onCommand:auraone.rubricStudio.validate",
    "workspaceContains:**/rubric.toml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "auraone.rubricStudio.open",
        "title": "Rubric Studio Open: Editor"
      },
      {
        "command": "auraone.rubricStudio.validate",
        "title": "Rubric Studio Open: Validate Project"
      },
      {
        "command": "auraone.rubricStudio.commands",
        "title": "Rubric Studio Open: Command Palette"
      },
      {
        "command": "auraone.rubricStudio.exportIntake",
        "title": "Rubric Studio Open: Export Local Evidence Summary"
      }
    ],
    "keybindings": [
      {
        "command": "auraone.rubricStudio.open",
        "key": "ctrl+k ctrl+r",
        "mac": "cmd+k cmd+r"
      },
      {
        "command": "auraone.rubricStudio.commands",
        "key": "ctrl+k ctrl+k",
        "mac": "cmd+k cmd+k"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^26.1.1"
  }
}
